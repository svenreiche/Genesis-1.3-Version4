# Writes the two field dumps which import_notime.in reads back: a fundamental
# and a third harmonic on the same time window of 24 slices. The two are given
# different powers and waists so that exchanging them would show in the
# comparison.

&setup
rootname=generate
lattice=lattice.lat
beamline=FEL
lambda0=1e-10
gamma0=11357.82
delz=0.1
&end

&time
slen=1.92e-8
sample=8
&end

&field
power=1e6
dgrid=2e-4
ngrid=51
waist_size=30e-6
&end

&field
power=2e3
dgrid=2e-4
ngrid=51
waist_size=20e-6
harm=3
&end

&write
field=dump
&end
